# --- Proton Bridge -----------------------------------------------------------
# Bridge holds the Proton account credentials and does all the OpenPGP work; the
# MCP server only speaks IMAP/SMTP to it over loopback.

# Your Proton address, as shown by `bridge --cli` -> `info`.
PROTON_BRIDGE_USER=you@proton.me

# The password Bridge generates FOR MAIL CLIENTS. This is not your Proton
# account password, and it is not your mailbox password.
PROTON_BRIDGE_PASSWORD=bridge-generated-password

# Where Bridge is listening. Defaults shown; change only if you moved the ports.
# PROTON_BRIDGE_HOST=127.0.0.1
# PROTON_IMAP_PORT=1143
# PROTON_SMTP_PORT=1025

# Bridge uses STARTTLS on both ports by default. Use "ssl" for implicit TLS or
# "none" for a Bridge build with TLS disabled.
# PROTON_IMAP_SECURITY=starttls
# PROTON_SMTP_SECURITY=starttls

# Bridge's certificate is self-signed by its own per-install CA, so verification
# is off by default. Set true only after importing that CA into the trust store.
# PROTON_TLS_VERIFY=false

# Address to put in the From header. Defaults to PROTON_BRIDGE_USER; set this
# only to send from a different address on the same account.
# PROTON_SEND_FROM=you@proton.me

# --- Transport ---------------------------------------------------------------
# "stdio" (default) for local use with Claude Code/Desktop; "http" for the
# hosted deployment behind the authentik-fronted reverse proxy.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
